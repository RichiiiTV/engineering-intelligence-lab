EIL_OLLAMA_BASE_URL=http://localhost:11434
EIL_OLLAMA_MODEL=qwen3.5:4b-q8_0
# Explicit self-hosted native vLLM client. Ollama remains the default.
EIL_MODEL_PROVIDER=ollama
# Linux / Slurm Ollama modules and optional native vLLM: docs/linux-hpc.md
# EIL_VLLM_BASE_URL=http://127.0.0.1:8002/v1
# EIL_VLLM_MODEL=eil-chat
# EIL_VLLM_REVISION=<reviewed local chat manifest SHA256>
# EIL_VLLM_VISION=0
# Set EIL_VLLM_API_KEY in the operator environment; never commit it.
# Set EIL_EMBEDDING_PROVIDER=ollama or vllm to override the generation-provider default.
# EIL_VLLM_EMBEDDING_BASE_URL=http://127.0.0.1:8003/v1
# EIL_VLLM_EMBEDDING_MODEL=eil-embed
# EIL_VLLM_EMBEDDING_REVISION=<reviewed local embedding manifest SHA256>
# EIL_VLLM_EMBEDDING_INPUT_FORMAT=plain
# Use qwen3 only with the reviewed Qwen3 embedding profile; reindex after changes.
# EIL_VLLM_EMBEDDING_API_KEY may use a separate operator-environment key.
# Native Linux server paths, model manifests and Slurm setup: docs/linux-hpc.md
# GPU-specific operator templates: scripts/hpc_profiles.py and docs/gpu-model-profiles.md
# Local semantic retrieval. Install this model in Ollama, then index documents in Administration.
EIL_EMBEDDING_MODEL=embeddinggemma:300m
# Rebuildable scoped disk retrieval indexes. Opt in only after measuring your corpus.
# Small corpora can be faster with the default bounded memory cache.
EIL_RETRIEVAL_DISK_CACHE=0
EIL_DATASET=synthetic_inspection_v1.csv
# Optional trusted local state location; default is .eil/ under the project root.
# EIL_STATE_DIR=C:/path/to/engineering-intelligence-lab/.eil
# Prefetched Docling assets must remain inside the approved .eil/docling-models directory.
# EIL_DOCLING_ARTIFACTS=C:/path/to/engineering-intelligence-lab/.eil/docling-models
# M5 hosted benchmark only: set OPENAI_API_KEY in the environment; never commit it.
# EIL_OPENAI_MODEL=<explicit hosted model ID selected by the operator>
